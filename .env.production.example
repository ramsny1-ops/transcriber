NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Replace with the exact HTTPS origins that host your production browser app.
ALLOWED_ORIGINS_PRODUCTION=https://voice.example.com,https://www.voice.example.com
ALLOWED_ORIGINS=

DATABASE_PATH=./data/voice-wave.sqlite
EXPORT_DIRECTORY=./data/exports
SESSION_TTL_HOURS=168
APP_SECRET=replace-with-a-long-random-production-secret
TRUST_PROXY=true
ALLOW_INSECURE_PRODUCTION_ORIGINS=false
