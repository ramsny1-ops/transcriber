NODE_ENV=development

# API / Bun / Express server
SERVER_HOST=127.0.0.1
SERVER_PORT=9367

# Add extra development origins here, for example your LAN address.
# These are ADDED to the automatic loopback origins instead of replacing them.
ALLOWED_ORIGINS_LOCAL=http://192.168.1.127:9367

# Production is never inherited from the development list.
ALLOWED_ORIGINS_PRODUCTION=

# Optional additional trusted origins shared by the active environment.
ALLOWED_ORIGINS=

DATABASE_PATH=./data/voice-wave.sqlite
EXPORT_DIRECTORY=./data/exports
SESSION_TTL_HOURS=168
APP_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
ALLOW_INSECURE_PRODUCTION_ORIGINS=false
