# Voice Wave Studio environment example
# Copy to .env and edit values as needed

# Use local Whisper transcription instead of OpenAI
USE_LOCAL_WHISPER=true
LOCAL_WHISPER_MODEL=tiny

# Optional: path to python binary (venv) used by the server when spawning transcribe.py
PYTHON_PATH=.venv-whisper/bin/python

# If set, OpenAI whisper-1 will be used instead of local transcription
# OPENAI_API_KEY=

# Set trust proxy for rate-limit behind a proxy/tunnel
TRUST_PROXY=true

# Server port
SERVER_PORT=9367
NODE_ENV=development

# API / Bun / Express server
SERVER_HOST=127.0.0.1
SERVER_PORT=9367

# For an EJS server-rendered app the browser and API share a single port.
ALLOWED_ORIGINS_LOCAL=http://192.168.1.127:9367

# Production must be explicit and HTTPS.
ALLOWED_ORIGINS_PRODUCTION=https://voice.example.com,https://www.voice.example.com

# Optional additional trusted origins shared by the active environment.
ALLOWED_ORIGINS=

DATABASE_PATH=./data/voice-wave.sqlite
EXPORT_DIRECTORY=./data/exports
SESSION_TTL_HOURS=168
APP_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
ALLOW_INSECURE_PRODUCTION_ORIGINS=false
